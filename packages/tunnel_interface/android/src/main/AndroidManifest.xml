<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Per-app proxy picker: Android 11+ package visibility filtering hides
         installed apps from getInstalledApplications unless this permission
         is declared (app is sideloaded, not Play-distributed). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <application>
        <service
            android:name="ai.zagros.tunnel.ZagrosVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>
</manifest>
